# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/resume_analyzer
# Gemini API key used for resume analysis (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: Gemini model (default gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# URL of the HackerRank hiring-agent service (services/hiring-agent)
HIRING_AGENT_URL=http://localhost:8000
